[Unit]
Description=Lawin backend (Daphne ASGI)
Documentation=file:/opt/lawin/app/deploy/README.md
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=simple
User=lawin
Group=lawin
WorkingDirectory=/opt/lawin/app
EnvironmentFile=/opt/lawin/app/.env
ExecStart=/opt/lawin/venv/bin/daphne -b 127.0.0.1 -p 8000 cafebook.asgi:application
Restart=always
RestartSec=3
TimeoutStopSec=15

# --- سخت‌سازی (Hardening) ---
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# فقط این مسیرها باید نوشتنی باشند (رسانه/استاتیک گردآوری‌شده)
ReadWritePaths=/opt/lawin/app/media /opt/lawin/app/staticfiles

[Install]
WantedBy=multi-user.target
