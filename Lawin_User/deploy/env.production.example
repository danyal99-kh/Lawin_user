# ============================================================================
# Lawin — نمونه‌ی فایل محیطی Production
# این فایل را روی لپ‌تاپ کافه به مسیر پروژه با نام دقیق «.env» کپی کنید و
# مقادیر را پر کنید. هرگز این فایلِ پرشده را در Git یا گزارش/ترمینال چاپ نکنید.
# ============================================================================

# --- Django ---
DJANGO_DEBUG=0
# یک رشته‌ی تصادفی بلند و یکتا (حداقل ۵۰ کاراکتر):
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=CHANGE_ME

# دامنه/هاست‌های مجاز. مثال با تونل Cloudflare:
#   DJANGO_ALLOWED_HOSTS=lawin.example.com,localhost,127.0.0.1
# اگر از Tailscale Funnel استفاده می‌کنید، هاست ts.net را اضافه کنید.
DJANGO_ALLOWED_HOSTS=CHANGE_ME

# مبدأهای مورد اعتماد CSRF (با طرح https کامل):
#   DJANGO_CSRF_ORIGINS=https://lawin.example.com
DJANGO_CSRF_ORIGINS=CHANGE_ME

# مبدأهای CORS فقط اگر کلاینت مرورگریِ جداگانه دارید؛ برای اپ Flutter لازم نیست.
DJANGO_CORS_ORIGINS=

# آدرسی که داخل QR Code چاپ می‌شود (بدون اسلش انتهایی).
# باید همان URL عمومی/پایدارِ HTTPS باشد.
PUBLIC_BASE_URL=CHANGE_ME

# --- PostgreSQL ---
POSTGRES_DB=lawin
POSTGRES_USER=lawin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Redis (اختیاری؛ فقط اگر بیش از یک پروسه‌ی daphne اجرا می‌کنید) ---
# برای یک پروسه‌ی daphne لازم نیست (InMemory کافی است).
# REDIS_URL=redis://127.0.0.1:6379/0

# --- امنیت HTTPS (وقتی HTTPS فعال شد) ---
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0
